# onnxruntime-node (pulled in by kokoro-js) runs a postinstall that tries to
# download onnxruntime-linux-x64-gpu-<version>.tgz from the GitHub release.
# That asset returns 404 for the pinned OnnxRuntime version, so `npm ci`
# fails on any Linux x64 machine: GitHub Actions, a fresh clone on Linux,
# or a container build. The CUDA execution provider is not used by ZOLA
# (voice runs through the browser/WASM path and Piper on the Pi), so skip it.
#
# If you ever need the CUDA EP locally, override with:
#   ONNXRUNTIME_NODE_INSTALL_CUDA=v12 npm ci
onnxruntime_node_install_cuda=skip